# AccuRAG Environment Variables
# Copy this file to .env and fill in the values you want to use.
# At least one web search API key is recommended for Web Mode and Smart Mode.
# Without any key, AccuRAG falls back to DuckDuckGo (may be rate-limited in some environments).

# -----------------------------------------------------------------------
# OPTION A: Tavily API (Recommended — free tier available)
# Sign up at https://app.tavily.com to get your API key.
# -----------------------------------------------------------------------
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------
# OPTION B: Serper Google Search API (Alternative — free tier available)
# Sign up at https://serper.dev to get your API key.
# -----------------------------------------------------------------------
# SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------
# HuggingFace Model Cache (Optional — set to 0 to allow downloading models)
# By default AccuRAG runs in offline mode using locally cached models.
# -----------------------------------------------------------------------
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
